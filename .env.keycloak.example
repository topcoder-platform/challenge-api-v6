# Migration branch only; never apply to current Auth0 workloads.
# USE_KEYCLOAK=true uses the KEYCLOAK_* settings; unset or false uses the AUTH0_* settings.
# Roll back by setting USE_KEYCLOAK=false and forcing a new deployment.
USE_KEYCLOAK=true
KEYCLOAK_ISSUER=https://keycloak.topcoder-dev.com/realms/topcoder-m2m-dev
KEYCLOAK_AUDIENCE=https://api.topcoder-dev.com
KEYCLOAK_TOKEN_URL=https://keycloak.topcoder-dev.com/m2m/token
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Auth0 M2M settings used when USE_KEYCLOAK is unset or false (leave unset rather than empty;
# AUTH0_PROXY_SERVER_URL defaults to AUTH0_URL, AUTH0_AUDIENCE to https://www.topcoder-dev.com).
# AUTH0_URL=
# AUTH0_PROXY_SERVER_URL=
# AUTH0_AUDIENCE=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# Keep existing member AUTH_SECRET and explicit VALID_ISSUERS.
# Set AUTH_USER_AUDIENCES to a JSON array, or explicitly retain legacy user behavior:
ALLOW_LEGACY_USER_AUDIENCE=true
