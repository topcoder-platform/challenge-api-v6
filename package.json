{
  "name": "topcoder-challenges-api",
  "version": "1.0.0",
  "description": "Topcoder Challenge API v6",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "postinstall": "pnpm run prisma:generate",
    "prisma:generate": "prisma generate --generator client",
    "lint": "eslint --no-error-on-unmatched-pattern \"*.ts\" \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"*.ts\" \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "create-tables": "prisma migrate dev",
    "seed-tables": "ts-node src/scripts/seed-tables.ts",
    "check-timeline-templates": "ts-node src/scripts/check-templates.ts",
    "recalculate-winners": "node --require ts-node/register/transpile-only data-migration/src/scripts/recalculateChallengeWinners.js",
    "recalculate-winners:csv": "node --require ts-node/register/transpile-only data-migration/src/scripts/recalculateChallengeWinners.js --csv-only",
    "test": "NODE_ENV=test mocha --require ts-node/register/transpile-only \"test/unit/**/*.test.{js,ts}\" --exit",
    "e2e": "NODE_ENV=test mocha --require ts-node/register/transpile-only \"test/e2e/*.test.{js,ts}\" --exit",
    "test:cov": "nyc --reporter=html --reporter=text pnpm test",
    "e2e:cov": "nyc --reporter=html --reporter=text pnpm e2e",
    "services:up": "docker-compose -f ./local/docker-compose.yml up -d",
    "services:down": "docker-compose -f ./local/docker-compose.yml down",
    "services:logs": "docker-compose -f ./local/docker-compose.yml logs",
    "deploy:dev": "BRANCH=$(git rev-parse --abbrev-ref HEAD) && TAG=\"dev-${BRANCH}\" && git tag -d \"$TAG\" 2>/dev/null; git push origin \":refs/tags/$TAG\" 2>/dev/null; git tag \"$TAG\" && git push origin \"$TAG\""
  },
  "author": "TCSCODER",
  "license": "MIT",
  "repository": "https://github.com/topcoder-platform/challenge-api",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "aws-sdk-client-mock": "^4.1.0",
    "chai": "^6.2.0",
    "chai-http": "^5.1.2",
    "mocha": "^11.7.4",
    "mocha-prepare": "^0.1.0",
    "nodemon": "^3.1.10",
    "nyc": "^18.0.0",
    "prettier": "^3.6.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "bluebird": "^3.7.2",
    "body-parser": "^2.3.0",
    "config": "^4.1.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "deep-equal": "^2.2.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.2",
    "express-interceptor": "^1.2.0",
    "get-parameter-names": "^0.3.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.3",
    "json-rules-engine": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "node-cache": "^5.1.2",
    "pg": "^8.16.3",
    "prisma": "7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tc-core-library-js": "github:topcoder-platform/tc-core-library-js#master",
    "topcoder-bus-api-wrapper": "github:topcoder-platform/tc-bus-api-wrapper#master",
    "uuid": "^14.0.1",
    "winston": "^3.18.3",
    "xss": "^1.0.15",
    "yamljs": "^0.3.0"
  },
  "engines": {
    "node": "26.x"
  },
  "volta": {
    "node": "26.x"
  }
}
