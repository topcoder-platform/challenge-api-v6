{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "entryFile": "main",
  "sourceRoot": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/phase-management/**/*.json",
        "outDir": "dist"
      },
      {
        "include": "src/scripts/seed/*.json",
        "outDir": "dist"
      }
    ]
  }
}
